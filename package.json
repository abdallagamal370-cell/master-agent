{
  "name": "master-study-hub",
  "version": "1.0.0",
  "description": "Local AI study companion for master's students: turn course PPTX/PDF files into study guides with summaries and key concepts (English/Arabic).",
  "type": "module",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js --open",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.11.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.3",
    "multer": "^2.5.0",
    "unpdf": "^2.1.0"
  }
}
